{
  "expo": {
    "name": "レンジャー",
    "slug": "marui-ranger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marui-ranger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maruibussan.ranger",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "プロフィール写真・顧客の店舗写真を撮影するために使用します。",
        "NSPhotoLibraryUsageDescription": "プロフィール写真・顧客の店舗写真を選択するために使用します。",
        "NSPhotoLibraryAddUsageDescription": "作成した画像をフォトライブラリに保存するために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.maruibussan.ranger",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A5F",
          "dark": {
            "backgroundColor": "#0A2540"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C9A876",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真・店舗写真を選択するために使用します。",
          "cameraPermission": "プロフィール写真・店舗写真を撮影するために使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/marui-ranger-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b07a600f-ee19-4fa1-a397-e958478c00b6"
      }
    },
    "owner": "ekanbe"
  }
}
